APP_NAME=AIXBI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aixbi
DB_USERNAME=aixbi
DB_PASSWORD=aixbi

ANALYTICS_DB_HOST=127.0.0.1
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_DATABASE=aixbi
ANALYTICS_DB_USERNAME=aixbi_reader
ANALYTICS_DB_PASSWORD=aixbi_reader

JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
AI_SERVICE_URL=http://127.0.0.1:8100
AI_SERVICE_TOKEN=dev-internal-token

SESSION_DRIVER=array   # stateless API: auth is bearer JWT
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync   # use redis + queue:work in production

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
PHP_CLI_SERVER_WORKERS=8

# Demo dataset size multiplier (1 ≈ 290k applications)
DEMO_SCALE=1
# Optional: Langfuse / Anthropic keys live in the AI service environment
