# AIXBI local settings for docker compose. start.bat / start.sh copy this to .env on first run.
# Everything works with these defaults on your own PC; change the secrets before exposing it to a network.

# Port the app is served on: http://localhost:8080
AIXBI_PORT=8080

# Secrets (any long random strings). Changing JWT_SECRET signs everyone out.
JWT_SECRET=change-me-in-production-0123456789abcdef0123
AI_SERVICE_TOKEN=change-me-internal-token
# Laravel key: base64 of 32 random bytes, e.g. from: openssl rand -base64 32  (prefix with base64:)
APP_KEY=base64:YmUhd7oFd1aIWbkuDx+MkWMe0oY4FGI7cWW2RZcsiC4=

# Database passwords. Set them before the first start; the database keeps the first values it was created with.
DB_PASSWORD=aixbi
ANALYTICS_DB_PASSWORD=aixbi_reader

# Optional: enables the Claude planner and narrator in the AI analyst.
# Without it, the deterministic planner answers the same questions (still grounded in governed data).
ANTHROPIC_API_KEY=
# AI gateway (optional): model per task, and the circuit breaker that switches to the
# deterministic engine for a minute after repeated provider failures.
AIXBI_MODEL=claude-opus-5-5
AIXBI_PLANNER_MODEL=
AIXBI_NARRATOR_MODEL=

# Hosts connectors may reach even though they are local, e.g. host.docker.internal for a database on this PC.
# Loopback and cloud-metadata addresses are otherwise refused.
CONNECTORS_ALLOW_HOSTS=
